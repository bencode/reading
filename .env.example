# Reading App Environment Configuration
# Copy this file to .env and update with your actual values

# Authentication Settings
# Generate with: openssl rand -hex 32
ACCESS_TOKEN=your_32_character_access_token_here

# JWT Secret for session security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# Admin Credentials
ADMIN_USERNAME=admin

# Admin Password Hash
# Generate with: node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# Database Configuration
DATABASE_PATH=/app/data/reading.db
NODE_ENV=production

# File Upload Configuration
# Production: Use /app/data/uploads for persistence with database
# Development: Use relative path to public directory
UPLOAD_DIR=/app/data/uploads

# LLM API Configuration
# For AI-powered content processing and image generation
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Image Optimization with imgproxy
# Set this to your imgproxy service URL (optional - will use original images if not set)
# For production with Caddy reverse proxy: https://your-domain.com/imgproxy
# For local development with Docker Compose: http://localhost:8080
NEXT_PUBLIC_IMGPROXY_URL=http://localhost:8080

# Python Backend (LLM Integration)
# Configure these in packages/tasks/.env as well