# Reading App Environment Configuration
# Copy this file to .env and update with your actual values

# Authentication Settings
# Generate with: openssl rand -hex 32
ACCESS_TOKEN=your_32_character_access_token_here

# JWT Secret for session security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# Admin Credentials
ADMIN_USERNAME=admin

# Admin Password Hash
# Generate with: node -e "console.log(require('bcrypt').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# Database Configuration
DATABASE_PATH=/app/data/reading.db
NODE_ENV=production

# Python Backend (LLM Integration)
# Configure these in packages/tasks/.env
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here